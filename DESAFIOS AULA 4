DESAFIO 1

Servidor:

from xmlrpc.server import SimpleXMLRPCServer

def soma(a, b):
    return a + b

def subtracao(a, b):
    return a - b

def multiplicacao(a, b):
    return a * b

servidor = SimpleXMLRPCServer(
    ("localhost", 8000),
    allow_none=True
)

servidor.register_function(soma, "soma")
servidor.register_function(subtracao, "subtracao")
servidor.register_function(multiplicacao, "multiplicacao")

servidor.serve_forever()

def divisao(a, b):
    if b == 0:
        return "Erro: divisão por zero"
    return a / b

CLIENTE:

import xmlrpc.client

servidor = xmlrpc.client.ServerProxy(
    "http://localhost:8000/"
)

print("10 + 5 =", servidor.soma(10, 5))
print("10 - 5 =", servidor.subtracao(10, 5))
print("10 x 5 =", servidor.multiplicacao(10, 5))

print("10 / 2 =", servidor.divisao(10, 2))
print("10 / 0 =", servidor.divisao(10, 0))

servidor.register_function(divisao, "divisao")

